# ---------------------------------------------------------------
# WCT Training RQ — environment variables
# Copy to .env on the server (chmod 600). NEVER commit real values:
# this repository is public.
# ---------------------------------------------------------------

# Public URL including base path (no trailing slash)
APP_URL=https://hrforms.wct.my/WCT-Training-RQ

# PostgreSQL connection
DATABASE_URL=postgres://wct_trq:CHANGE_ME@127.0.0.1:5432/wct_training_rq

# Session cookie encryption key — at least 32 random characters
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Microsoft Entra ID app registration (see docs/ENTRA_SETUP.md)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Company-wide people search needs the Graph application permission User.Read.All
# (admin consent). Without it, set false: the picker then searches users who have
# already signed in, and admins can still add people by name + email.
DIRECTORY_SEARCH_GRAPH=true

# Power Automate "When an HTTP request is received" flow URL (see docs/POWER_AUTOMATE.md)
POWER_AUTOMATE_FLOW_URL=

# Shared secret for the cron endpoint that retries failed notifications
# Generate: openssl rand -hex 32
CRON_SECRET=

# Where uploaded attachments are stored (outside the app directory)
UPLOAD_DIR=/var/lib/wct-training-rq/uploads

# Comma-separated emails that become System Admin on first sign-in
BOOTSTRAP_ADMIN_EMAILS=bian-qi.phua@wct.my

# Development only — enables "sign in as demo user". Ignored in production.
AUTH_DEV_LOGIN=false
